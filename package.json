{
  "name": "bitbucket-mcp",
  "version": "0.1.0",
  "description": "MCP server for Bitbucket Cloud - PR/code review workflow",
  "license": "MIT",
  "author": "Stanley Ihesiulo",
  "type": "module",
  "bin": {
    "bitbucket-mcp": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "prepare": "npm run build",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:contract": "vitest run --config vitest.contract.config.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "typescript": "^5.7.3",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": ">=20"
  }
}
